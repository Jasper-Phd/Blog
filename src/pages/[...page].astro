---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import Pagination from "../components/Pagination.astro";
import PostListItem from "../components/PostListItem.astro";
import SwingDivider from "../components/SwingDivider.astro";
import { SITE } from "../config";
import Layout from "../layouts/Layout.astro";
import { postFilter, sortByPubDate, type Post } from "../utils";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection("posts", postFilter)).sort(sortByPubDate);
  return paginate(posts, { pageSize: SITE.postsPerPage });
};

const { page } = Astro.props as { page: Page<Post> };
const isFirstPage = page.currentPage === 1;
---

<Layout>
  <h1 class="sr-only">
    {isFirstPage ? SITE.title : `第 ${page.currentPage} 页`}
  </h1>

  {
    page.data.length > 0 ? (
      <div class="post-list">
        {page.data.map((post, index) => (
          <Fragment>
            {index > 0 && <SwingDivider />}
            <PostListItem post={post} />
          </Fragment>
        ))}
      </div>
    ) : (
      <p class="muted text-[0.9375rem]">
        还没有文章。在 <code>src/content/posts/</code> 里新建一个 Markdown 文件就能发布。
      </p>
    )
  }

  <Pagination page={page} />
</Layout>
