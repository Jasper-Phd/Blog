---
import type { Post } from "../utils";
import { postUrl, readingTime, tagUrl } from "../utils";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDatetime, tags, featured } = post.data;
---

<article class="card">
  <a href={postUrl(post)} class="absolute inset-0 z-0" aria-label={title}></a>

  <div class="muted flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.8125rem]">
    <FormattedDate date={pubDatetime} />
    <span aria-hidden="true">·</span>
    <span>约 {readingTime(post.body)} 分钟</span>
    {
      featured && (
        <>
          <span aria-hidden="true">·</span>
          <span class="accent-text font-medium">精选</span>
        </>
      )
    }
  </div>

  <h3 class="card-title mt-1.5 mb-0 leading-snug">{title}</h3>

  {description && <p class="soft mt-2 mb-0 text-[0.9375rem] leading-relaxed">{description}</p>}

  {
    tags.length > 0 && (
      <div class="relative z-10 mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <a href={tagUrl(tag)} class="tag">
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
