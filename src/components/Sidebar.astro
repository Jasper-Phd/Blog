---
import { existsSync } from "node:fs";
import { getCollection } from "astro:content";
import { SITE } from "../config";
import {
  getUniqueCategories,
  getUniqueTags,
  href,
  postFilter,
} from "../utils";

const posts = await getCollection("posts", postFilter);

const stats = [
  { label: "文章", value: posts.length, url: href("/archives/") },
  { label: "分类", value: getUniqueCategories(posts).length, url: href("/categories/") },
  { label: "标签", value: getUniqueTags(posts).length, url: href("/tags/") },
];

// 把 avatar.jpg / avatar.png 放进 public/ 目录就会自动替换占位头像
const avatarFile = [
  "avatar.jpg",
  "avatar.jpeg",
  "avatar.png",
  "avatar.webp",
  "avatar.svg",
].find((file) => existsSync(`public/${file}`));

const avatarSrc = href(`/${avatarFile ?? "avatar.svg"}`);

const pathname = Astro.url.pathname;
const homePath = href("/");
const isCurrent = (target: string) => {
  const path = href(target);
  // 首页必须精确匹配，否则所有路径都会命中
  return path === homePath ? pathname === homePath : pathname.startsWith(path);
};

const starPath =
  "M16 4.5 L18.7 12.28 L26.94 12.45 L20.38 17.42 L22.76 25.3 L16 20.6 L9.24 25.3 L11.63 17.42 L5.06 12.45 L13.3 12.28 Z";
---

<aside class="sidebar" id="sidebar" aria-label="站点导航与信息">
  <a href={href("/")} class="sidebar-brand">
    <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
      <path d={starPath} fill="var(--accent)"></path>
    </svg>
    <span>{SITE.title}</span>
  </a>
  <p class="sidebar-author">{SITE.author}</p>
  <p class="sidebar-tagline">{SITE.tagline}</p>

  <nav class="mt-5" aria-label="主导航">
    <ul class="m-0 flex list-none flex-col gap-0.5 p-0">
      {
        SITE.nav.map((item) => (
          <li>
            <a
              href={href(item.href)}
              class="sidebar-nav-link"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              <span class="dot" aria-hidden="true" />
              <span>{item.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-7">
    <img
      src={avatarSrc}
      alt={`${SITE.author} 的头像`}
      class="avatar"
      width="208"
      height="208"
      loading="lazy"
      decoding="async"
    />
  </div>

  <section class="mt-7">
    <h2 class="sidebar-heading">统计</h2>
    <ul class="m-0 grid list-none grid-cols-3 gap-2 p-0">
      {
        stats.map((item) => (
          <li>
            <a href={item.url} class="stat">
              <span class="stat-num">{item.value}</span>
              <span class="stat-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-7">
    <h2 class="sidebar-heading">联系方式</h2>
    <div class="flex flex-col gap-2">
      <a href={`mailto:${SITE.email}`} class="contact-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
          <path d="m3 7.5 9 6 9-6"></path>
        </svg>
        <span class="min-w-0 truncate">{SITE.email}</span>
        <svg
          class="arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <a
        href={`https://github.com/${SITE.githubUser}`}
        class="contact-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.9 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.2 4.9 18.2 5.2 18.2 5.2c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"
          ></path>
        </svg>
        <span class="min-w-0 truncate">@{SITE.githubUser}</span>
        <svg
          class="arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </section>

  {
    SITE.friends.length > 0 && (
      <section class="mt-7">
        <h2 class="sidebar-heading">友链</h2>
        <ul class="m-0 list-none p-0">
          {SITE.friends.map((friend) => (
            <li>
              <a
                href={friend.href}
                class="friend-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {friend.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-7 flex items-center gap-2 border-t pt-4" style="border-color: var(--border);">
    <a href={href("/search/")} class="icon-btn" aria-label="搜索文章">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6"></path>
      </svg>
    </a>

    <button type="button" class="icon-btn" data-theme-toggle aria-label="切换深浅色主题">
      <svg
        class="theme-icon-moon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
      <svg
        class="theme-icon-sun"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.2"></circle>
        <path
          d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
        ></path>
      </svg>
    </button>

    <a href={href("/rss.xml")} class="icon-btn" aria-label="RSS 订阅">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5.5" cy="18.5" r="1.5" fill="currentColor" stroke="none"></circle>
      </svg>
    </a>
  </div>
</aside>
