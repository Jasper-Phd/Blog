---
import { SITE } from "../config";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur-md"
  style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 80%, transparent);"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-2 px-5">
    <a href="/" class="mr-auto flex items-center gap-2.5">
      <svg
        width="24"
        height="24"
        viewBox="0 0 32 32"
        aria-hidden="true"
        class="shrink-0"
      >
        <path
          d="M16 4.5 L18.7 12.28 L26.94 12.45 L20.38 17.42 L22.76 25.3 L16 20.6 L9.24 25.3 L11.63 17.42 L5.06 12.45 L13.3 12.28 Z"
          fill="var(--accent)"></path>
      </svg>
      <span class="text-[1.0625rem] font-semibold tracking-tight">{SITE.title}</span>
    </a>

    <nav class="hidden items-center gap-0.5 sm:flex" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.text}
          </a>
        ))
      }
    </nav>

    <a href="/search/" class="icon-btn" aria-label="搜索文章">
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6"></path>
      </svg>
    </a>

    <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深浅色主题">
      <svg
        class="theme-icon-moon"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
      <svg
        class="theme-icon-sun"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.2"></circle>
        <path
          d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
        ></path>
      </svg>
    </button>
  </div>

  <nav
    class="mx-auto flex max-w-5xl gap-1 overflow-x-auto px-4 pb-2.5 sm:hidden"
    aria-label="主导航（移动端）"
  >
    {
      SITE.nav.map((item) => (
        <a
          href={item.href}
          class="nav-link shrink-0"
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.text}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .theme-icon-sun {
    display: none;
  }
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .theme-icon-sun {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;

    toggle.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* 隐私模式下忽略 */
      }
    });
  })();
</script>
