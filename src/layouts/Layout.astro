---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE } from "../config";
import type { TocEntry } from "../utils";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  noindex?: boolean;
  /** 传入后左侧栏下块会多出一个「目录」区块 */
  toc?: TocEntry[];
}

const { title, description, ogType, publishedTime, noindex, toc } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} data-lang="zh">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogType={ogType}
      publishedTime={publishedTime}
      noindex={noindex}
    />
    <script is:inline>
      // 尽早决定主题，避免刷新时闪白
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = stored ?? (prefersDark ? "dark" : "light");
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <script is:inline>
      // 尽早决定语言，避免切换前的闪烁
      (() => {
        try {
          const stored = localStorage.getItem("lang");
          if (stored === "en" || stored === "zh") {
            document.documentElement.dataset.lang = stored;
          }
        } catch {
          /* 隐私模式下忽略 */
        }
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-[var(--accent)] focus:px-3 focus:py-2 focus:text-[var(--accent-fg)]"
      >跳到正文</a
    >

    <div class="mx-auto flex w-full max-w-[1080px] gap-5 px-5 py-8 lg:gap-8">
      <Sidebar toc={toc} />

      <div class="flex min-w-0 flex-1 flex-col">
        <Header />

        <div class="content-panel">
          <main id="main" data-pagefind-body>
            <slot />
          </main>

          <Footer />
        </div>
      </div>
    </div>

    <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

    <script is:inline>
      (() => {
        const body = document.body;
        const trigger = document.getElementById("menu-open");
        const backdrop = document.getElementById("sidebar-backdrop");
        const sidebar = document.getElementById("sidebar");

        const setOpen = (open) => {
          body.classList.toggle("drawer-open", open);
          trigger?.setAttribute("aria-expanded", String(open));
        };

        trigger?.addEventListener("click", () =>
          setOpen(!body.classList.contains("drawer-open")),
        );
        backdrop?.addEventListener("click", () => setOpen(false));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setOpen(false);
        });
        sidebar?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.addEventListener("click", () => {
            const root = document.documentElement;
            const next = root.dataset.theme === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try {
              localStorage.setItem("theme", next);
            } catch {
              /* 隐私模式下忽略 */
            }
          });
        });

        document.querySelectorAll("[data-lang-toggle]").forEach((button) => {
          button.addEventListener("click", () => {
            const root = document.documentElement;
            const next = root.dataset.lang === "en" ? "zh" : "en";
            root.dataset.lang = next;
            try {
              localStorage.setItem("lang", next);
            } catch {
              /* 隐私模式下忽略 */
            }
          });
        });
      })();
    </script>
  </body>
</html>
