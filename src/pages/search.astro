---
import Layout from "../layouts/Layout.astro";

const bundlePath = `${import.meta.env.BASE_URL}pagefind/`;
const basePath = import.meta.env.BASE_URL;
---

<Layout title="搜索" description="站内全文搜索">
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title m-0 mb-2">搜索</h1>
    <p class="muted mt-0 mb-6 text-[0.9375rem]">输入关键词，全文检索本站所有文章。</p>

    <div id="search" data-bundle-path={bundlePath} data-base-path={basePath}></div>

    <p id="search-fallback" class="muted mt-4 hidden text-[0.875rem]">
      搜索索引在正式构建时生成。本地想试：先跑 <code>npm run build</code>，再跑
      <code>npm run preview</code>。
    </p>
  </div>

  <link rel="stylesheet" href={`${bundlePath}pagefind-ui.css`} />
  <script is:inline src={`${bundlePath}pagefind-ui.js`}></script>
  <script is:inline>
    (() => {
      const mount = () => {
        const host = document.getElementById("search");
        const fallback = document.getElementById("search-fallback");
        if (window.PagefindUI && host) {
          const base = host.dataset.basePath || "/";
          new window.PagefindUI({
            element: "#search",
            bundlePath: host.dataset.bundlePath,
            showSubResults: true,
            // 站点部署在子路径下时，把搜索结果的链接补上前缀。
            // 这里返回新对象而不是原地修改，避免重复渲染时前缀叠加。
            processResult: (result) => {
              const target = String(result.url);
              const url = target.startsWith(base) ? target : base + target.replace(/^\//, "");
              return { ...result, url };
            },
            translations: {
              placeholder: "搜索文章…",
              clear_search: "清除",
              load_more: "加载更多结果",
              search_label: "搜索本站",
              filters_label: "筛选",
              zero_results: "没有找到与 [SEARCH_TERM] 相关的内容",
              many_results: "找到 [COUNT] 条与 [SEARCH_TERM] 相关的内容",
              one_result: "找到 1 条与 [SEARCH_TERM] 相关的内容",
              searching: "搜索中…",
            },
          });
        } else {
          fallback?.classList.remove("hidden");
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", mount);
      } else {
        mount();
      }
    })();
  </script>
</Layout>
