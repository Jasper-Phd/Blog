---
import { Image } from "astro:assets";
import T from "../components/T.astro";
import Layout from "../layouts/Layout.astro";

// 把图片放进 src/assets/gallery/，构建时会自动压缩并出现在这里
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const images = Object.entries(modules)
  .map(([path, mod]) => ({
    src: mod.default,
    name: path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "",
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="展示廊" description="图片展示">
  <h1 class="page-title m-0 mb-3">
    <T zh="展示廊" en="Gallery" />
  </h1>
  <p class="muted m-0 mb-8 text-[0.9375rem]">
    <T zh="收录一些照片与图片。" en="A collection of photos and images." />
  </p>

  {
    images.length > 0 ? (
      <ul class="gallery-grid">
        {images.map((image) => (
          <li>
            <Image
              src={image.src}
              alt={image.name}
              widths={[400, 800]}
              sizes="(max-width: 640px) 100vw, 320px"
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state">
        <svg width="56" height="56" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <rect
            x="5"
            y="9"
            width="38"
            height="30"
            rx="5"
            stroke="currentColor"
            stroke-width="1.6"></rect>
          <circle cx="16" cy="19" r="2.8" stroke="currentColor" stroke-width="1.6"></circle>
          <path
            d="M7 34l10-8 6 5 5-4 13 9"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <p>
          <T
            zh="这里还空着。把图片放进 src/assets/gallery/ 目录，构建时会自动压缩并出现在这里。"
            en="Nothing here yet. Drop images into src/assets/gallery/ and they will be optimised and shown here."
          />
        </p>
      </div>
    )
  }
</Layout>
