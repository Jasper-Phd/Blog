---
import type { Post } from "../utils";
import {
  categoryUrl,
  excerpt,
  postUrl,
  readingTime,
  tagUrl,
  wordCount,
} from "../utils";
import FormattedDate from "./FormattedDate.astro";
import T from "./T.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDatetime, tags, categories } = post.data;

const summary = excerpt(post.body, 300) || description;
const category = categories[0];
const words = wordCount(post.body);
const minutes = readingTime(post.body);
---

<article class="post-item">
  <h3 class="post-title">
    <a href={postUrl(post)}>{title}</a>
  </h3>

  <div class="post-meta-line">
    <span class="meta-item">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"></rect>
        <path d="M3.5 9.5h17M8 3.5v3M16 3.5v3"></path>
      </svg>
      <T zh="发表于" en="Posted" />
      <FormattedDate date={pubDatetime} />
    </span>

    <span class="meta-sep" aria-hidden="true"></span>

    {
      category && (
        <a class="meta-item" href={categoryUrl(category)}>
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3.2 7.6A1.6 1.6 0 0 1 4.8 6h3.9l2 2.5h7.5a1.6 1.6 0 0 1 1.6 1.6v7.3a1.6 1.6 0 0 1-1.6 1.6H4.8a1.6 1.6 0 0 1-1.6-1.6z"></path>
          </svg>
          <T zh="分类于" en="in" />
          {category}
        </a>
      )
    }

    <span class="meta-sep" aria-hidden="true"></span>

    <span class="meta-item">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 3.5h7l5 5V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z"></path>
        <path d="M13 3.5V9h4.5"></path>
        <path d="M8.5 13.5h6M8.5 16.5h4"></path>
      </svg>
      <T zh="字数统计：" en="Words: " />
      {words}
    </span>

    <span class="meta-sep" aria-hidden="true"></span>

    <span class="meta-item">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="8.5"></circle>
        <path d="M12 7.5V12l3 2"></path>
      </svg>
      <T zh="阅读时长约" en="About" />
      {minutes}
      <T zh="分钟" en="min" />
    </span>
  </div>

  {summary && <p class="post-excerpt">{summary}</p>}

  <div class="post-foot">
    <div class="post-tags">
      {
        tags.map((tag) => (
          <a href={tagUrl(tag)} class="tag">
            #{tag}
          </a>
        ))
      }
    </div>

    <a class="btn-read" href={postUrl(post)}>
      <T zh="阅读全文" en="Read more" />
      <svg
        class="arrow"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h13M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>
