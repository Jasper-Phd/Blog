---
import type { GetStaticPaths, Page } from "astro";
import { getCollection } from "astro:content";
import Pagination from "../components/Pagination.astro";
import PostListItem from "../components/PostListItem.astro";
import { SITE } from "../config";
import Layout from "../layouts/Layout.astro";
import { postFilter, sortByPubDate, type Post } from "../utils";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection("posts", postFilter)).sort(sortByPubDate);
  return paginate(posts, { pageSize: SITE.postsPerPage });
};

const { page } = Astro.props as { page: Page<Post> };
const isFirstPage = page.currentPage === 1;
---

<Layout>
  <section class="mb-7 border-b pb-6" style="border-color: var(--border);">
    <h1 class="m-0 text-[1.6rem] font-bold leading-tight tracking-tight">
      {isFirstPage ? "最新文章" : `第 ${page.currentPage} 页`}
    </h1>
    {
      isFirstPage && (
        <p class="soft m-0 mt-3 max-w-2xl text-[0.9375rem] leading-relaxed">
          {SITE.description}
        </p>
      )
    }
  </section>

  {
    page.data.length > 0 ? (
      <div class="post-list">
        {page.data.map((post) => (
          <PostListItem post={post} />
        ))}
      </div>
    ) : (
      <p class="muted text-[0.9375rem]">
        还没有文章。在 <code>src/content/posts/</code> 里新建一个 Markdown 文件就能发布。
      </p>
    )
  }

  <Pagination page={page} />
</Layout>

