---
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Layout from "../layouts/Layout.astro";
import { groupByYear, postFilter, postUrl, sortByPubDate } from "../utils";
import T from "../components/T.astro";

const posts = (await getCollection("posts", postFilter)).sort(sortByPubDate);
const groups = groupByYear(posts);
const yearToc = groups.map(([year]) => ({
  depth: 2,
  text: `${year} 年`,
  slug: year,
}));
---

<Layout title="归档" description="按年份浏览全部文章" toc={yearToc}>
  <header class="mb-8">
    <h1 class="page-title m-0"><T zh="归档" en="Archive" /></h1>
    <p class="muted mt-2 mb-0 text-[0.9375rem]">
      <T zh={`共 ${posts.length} 篇文章`} en={`${posts.length} posts in total`} />
    </p>
  </header>

  <div class="flex flex-col gap-10">
    {
      groups.map(([year, list]) => (
        <section>
          <h2
            id={year}
            class="m-0 mb-4 flex items-baseline gap-3 text-[1.25rem] font-semibold tracking-tight"
          >
            {year}
            <span class="muted text-[0.8125rem] font-normal">
              <T zh={`${list.length} 篇`} en={`${list.length}`} />
            </span>
          </h2>
          <ul class="m-0 list-none space-y-2.5 p-0">
            {list.map((post) => (
              <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-4">
                <span class="muted shrink-0 font-mono text-[0.8125rem]">
                  <FormattedDate date={post.data.pubDatetime} />
                </span>
                <a
                  href={postUrl(post)}
                  class="soft transition-colors hover:text-[var(--accent)]"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
