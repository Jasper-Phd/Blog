---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import photo from "../assets/photo.jpg";
import { SITE } from "../config";
import T from "./T.astro";
import {
  getUniqueCategories,
  getUniqueTags,
  href,
  postUrl,
  postFilter,
  type TocEntry,
} from "../utils";

interface Props {
  /** 当前页面的目录；为空表示这一页不需要目录 */
  toc?: TocEntry[];
}

const { toc = [] } = Astro.props;
const tocItems = toc.filter((item) => item.depth <= 3);

const posts = await getCollection("posts", postFilter);

const stats = [
  { zh: "文章", en: "Posts", value: posts.length, url: href("/archives/") },
  {
    zh: "分类",
    en: "Categories",
    value: getUniqueCategories(posts).length,
    url: href("/categories/"),
  },
  { zh: "标签", en: "Tags", value: getUniqueTags(posts).length, url: href("/tags/") },
];

/** 「随风」按钮随机跳转的候选列表 */
const randomPool = posts.map((post) => postUrl(post)).join("|");

const pathname = Astro.url.pathname;
const homePath = href("/");
const isCurrent = (target: string) => {
  const path = href(target);
  // 首页必须精确匹配，否则所有路径都会命中
  return path === homePath ? pathname === homePath : pathname.startsWith(path);
};

/** 导航图标。想换图标就在 config.ts 的 nav 里改 icon 名字，可选值见这里。 */
const navIcons: Record<string, string[]> = {
  home: [
    "M4 10.6 12 4.2l8 6.4V19a1.2 1.2 0 0 1-1.2 1.2h-3.6v-5.6H8.8v5.6H5.2A1.2 1.2 0 0 1 4 19z",
  ],
  folder: [
    "M3.2 7.6A1.6 1.6 0 0 1 4.8 6h3.9l2 2.5h7.5a1.6 1.6 0 0 1 1.6 1.6v7.3a1.6 1.6 0 0 1-1.6 1.6H4.8a1.6 1.6 0 0 1-1.6-1.6z",
  ],
  tag: [
    "M11.4 3.6H20.4V12.6l-8.2 8.2a1.8 1.8 0 0 1-2.5 0l-5.5-5.5a1.8 1.8 0 0 1 0-2.5z",
    "M16.3 8.3h.01",
  ],
  archive: [
    "M3.6 5.4h16.8a1 1 0 0 1 1 1v2.2a1 1 0 0 1-1 1H3.6a1 1 0 0 1-1-1V6.4a1 1 0 0 1 1-1z",
    "M4.8 9.6v9a1 1 0 0 0 1 1h12.4a1 1 0 0 0 1-1v-9",
    "M10 13.6h4",
  ],
  user: [
    "M12 12.4a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2z",
    "M5 20.6a7 7 0 0 1 14 0",
  ],
  link: [
    "M10.5 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1 1",
    "M13.5 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1-1",
  ],
  academic: [
    "M12 4 2.6 8.6 12 13.2l9.4-4.6z",
    "M6.2 11v4.4c0 1.4 2.6 2.6 5.8 2.6s5.8-1.2 5.8-2.6V11",
  ],
  resources: [
    "M4 5.6A1.6 1.6 0 0 1 5.6 4H11v16H5.6A1.6 1.6 0 0 1 4 18.4z",
    "M11 4h7.4A1.6 1.6 0 0 1 20 5.6v12.8a1.6 1.6 0 0 1-1.6 1.6H11z",
  ],
  gallery: [
    "M3.5 6.5A2 2 0 0 1 5.5 4.5h13a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z",
    "M9.2 10.4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z",
    "m4 17.5 4.8-4.3 3.4 2.9 2.9-2.4 4.9 3.8",
  ],
};
---

<aside class="sidebar" id="sidebar" aria-label="站点导航与信息">
  <!-- 上块：身份区 + 导航 -->
  <div class="sidebar-block sidebar-block--tint">
  <div class="sidebar-header">
    <a href={href("/")} class="sidebar-brand">{SITE.title}</a>
    <p class="sidebar-author">{SITE.author}</p>
    <p class="sidebar-tagline">{SITE.tagline}</p>
    <svg
      class="sidebar-sprig"
      width="72"
      height="18"
      viewBox="0 0 72 18"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4 12C20 4 52 4 68 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        opacity="0.6"></path>
      <path d="M22 8C26 2 34 2 38 7C34 12 26 12 22 8Z" fill="currentColor" opacity="0.5"></path>
      <path d="M40 6C44 1 52 1 55 6C51 11 43 11 40 6Z" fill="currentColor" opacity="0.38"></path>
      <path d="M10 11C13 6 20 6 23 10C20 15 13 15 10 11Z" fill="currentColor" opacity="0.32"></path>
    </svg>
  </div>

  <nav class="mt-4" aria-label="主导航">
    <ul class="m-0 flex list-none flex-col gap-0 p-0">
      {
        SITE.nav.map((item) => {
          const paths = navIcons[item.icon] ?? [];

          return (
            <li>
              <a
                href={href(item.href)}
                class="sidebar-nav-link"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {paths.length > 0 ? (
                  <svg
                    class="nav-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {paths.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                ) : (
                  <span class="dot" aria-hidden="true" />
                )}
                <T zh={item.zh} en={item.en} />
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  </div>

  <!-- 下块：头像 / 统计 / 联系方式 / 友链 / 工具行 -->
  <div class="sidebar-block">
  <div id="resume-card" class="mb-4" hidden>
    <h2 class="leaf-heading">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 4.5h7a2 2 0 0 1 2 2v13a1.6 1.6 0 0 0-1.6-1.6H4z"></path>
        <path d="M20 4.5h-5a2 2 0 0 0-2 2v13a1.6 1.6 0 0 1 1.6-1.6H20z"></path>
      </svg>
      <T zh="继续阅读" en="Continue" />
    </h2>
    <a id="resume-link" class="resume-link" href="#">
      <span id="resume-title"></span>
      <span id="resume-progress" class="resume-progress"></span>
    </a>
  </div>

  <div>
    <Image
      src={photo}
      alt={`${SITE.author} 的照片`}
      class="avatar"
      width={360}
      format="webp"
      quality={82}
      loading="lazy"
    />
  </div>

  <section class="mt-6">
    <h2 class="leaf-heading">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
      </svg>
      <T zh="统计" en="Statistics" />
    </h2>
    <ul class="m-0 grid list-none grid-cols-3 gap-2 p-0">
      {
        stats.map((item) => (
          <li>
            <a href={item.url} class="stat">
              <span class="stat-num">{item.value}</span>
              <span class="stat-label">
                <T zh={item.zh} en={item.en} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    tocItems.length > 1 && (
      <section class="mt-6">
        <h2 class="leaf-heading">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h10M4 18h13"></path>
          </svg>
          <T zh="目录" en="Contents" />
        </h2>
        <nav class="sidebar-toc" aria-label="本页目录">
          <ul class="m-0 list-none p-0">
            {tocItems.map((item) => (
              <li class={item.depth > 2 ? "is-sub" : undefined}>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </section>
    )
  }

  <section class="mt-6">
    <h2 class="leaf-heading">
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
      </svg>
      <T zh="联系方式" en="Contact" />
    </h2>
    <div class="flex flex-col gap-2">
      <a href={`mailto:${SITE.email}`} class="contact-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
          <path d="m3 7.5 9 6 9-6"></path>
        </svg>
        <span class="min-w-0 truncate">{SITE.email}</span>
        <svg
          class="arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <a
        href={`https://github.com/${SITE.githubUser}`}
        class="contact-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.9 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.2 4.9 18.2 5.2 18.2 5.2c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"
          ></path>
        </svg>
        <span class="min-w-0 truncate">@{SITE.githubUser}</span>
        <svg
          class="arrow"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </section>

  {
    SITE.friends.length > 0 && (
      <section class="mt-6">
        <h2 class="leaf-heading">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
          <T zh="友链" en="Friends" />
        </h2>
        <ul class="m-0 list-none p-0">
          {SITE.friends.map((friend) => (
            <li>
              <a
                href={friend.href}
                class="friend-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {friend.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-6 flex items-center gap-2 border-t pt-4" style="border-color: var(--border);">
    <a href={href("/search/")} class="icon-btn" aria-label="搜索文章">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6"></path>
      </svg>
    </a>

    <button type="button" class="icon-btn" data-theme-toggle aria-label="切换深浅色主题">
      <svg
        class="theme-icon-moon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
      <svg
        class="theme-icon-sun"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.2"></circle>
        <path
          d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
        ></path>
      </svg>
    </button>

    <button
      type="button"
      class="icon-btn"
      data-lang-toggle
      aria-label="切换语言 / Switch language"
    >
      <span class="lang-zh text-[0.6875rem] font-semibold tracking-wide">EN</span>
      <span class="lang-en text-[0.6875rem] font-semibold tracking-wide">中</span>
    </button>

    <button
      type="button"
      class="icon-btn"
      data-random-post={randomPool}
      aria-label="随机读一篇 / Random post"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 8h9.5a3.2 3.2 0 1 0-3.2-3.2"></path>
        <path d="M3 16h6.5"></path>
        <path d="M3 12h14.5a3.2 3.2 0 1 1-3.2 3.2"></path>
      </svg>
    </button>

    <a href={href("/rss.xml")} class="icon-btn" aria-label="RSS 订阅">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5.5" cy="18.5" r="1.5" fill="currentColor" stroke="none"></circle>
      </svg>
    </a>
  </div>
  </div>
</aside>
