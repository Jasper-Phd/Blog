---
import NatureScene from "./NatureScene.astro";
import T from "./T.astro";
import { SITE } from "../config";
import { href } from "../utils";

const year = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  timeZone: SITE.timezone,
}).format(new Date());

const siteAge = Math.max(
  0,
  Math.floor((Date.now() - new Date(SITE.since).getTime()) / 86400000),
);
---

<footer class="content-footer">
  <div class="flex justify-center pt-6">
    <NatureScene />
  </div>

  <div
    class="muted flex flex-col items-center justify-between gap-3 py-6 text-[0.8125rem] sm:flex-row"
  >
    <p class="m-0">
      © {year} {SITE.author} · {SITE.title}
      <span aria-hidden="true"> · </span>
      <T zh="本站已运行" en="Running for" />
      <span id="site-age" data-since={SITE.since}>{siteAge}</span>
      <T zh="天" en="days" />
      {
        SITE.visitorCounter && (
          <>
            <span aria-hidden="true"> · </span>
            <span id="busuanzi_container_site_uv" style="display:none">
              <T zh="访客" en="Visitors" />
              <span id="busuanzi_value_site_uv"></span>
            </span>
          </>
        )
      }
    </p>
    <div class="flex items-center gap-4">
      {
        SITE.social.map((item) => (
          <a
            href={item.href.startsWith("http") ? item.href : href(item.href)}
            class="transition-colors hover:text-[var(--accent)]"
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {item.name}
          </a>
        ))
      }
      <span aria-hidden="true">·</span>
      <a
        href="https://astro.build"
        class="transition-colors hover:text-[var(--accent)]"
        target="_blank"
        rel="noopener noreferrer">Astro</a
      >
    </div>
  </div>
</footer>
